rules_version = '2';
// EgyGulf catalog + invoices — paste into Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function active() { return hasProfile() && me().active == true; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function isBootstrapAdmin() { return signedIn() && request.auth.token.email == 'admin@egygulf.app'; }

    // ── users/{uid}: profile + role ──
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Admin creates users; the bootstrap admin may create its own admin profile once.
      allow create: if isAdmin()
                    || (isBootstrapAdmin() && uid == request.auth.uid && !exists(profilePath()));
      // Admin edits others (not their own role/active flag, so they can't lock themselves out).
      allow update: if isAdmin() && (uid != request.auth.uid
                    || (request.resource.data.role == resource.data.role
                        && request.resource.data.active == resource.data.active));
      allow delete: if false;
    }

    // ── invoices/{number}: each user sees own, admin sees all ──
    match /invoices/{id} {
      function isOwner() { return resource.data.ownerUid == request.auth.uid; }
      function validShape(d) {
        return d.number is string && d.number == id
            && d.items is list && d.items.size() <= 200
            && d.total is number && d.ownerUid is string;
      }
      allow read: if active() && (isOwner() || isAdmin());
      allow create: if active()
                    && request.resource.data.ownerUid == request.auth.uid
                    && validShape(request.resource.data);
      allow update: if active() && (isOwner() || isAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.number == resource.data.number
                    && validShape(request.resource.data);
      allow delete: if active() && (isOwner() || isAdmin());
    }

    // ── counters/{year}: sequential invoice numbers ──
    match /counters/{year} {
      allow read: if active();
      allow create: if active() && request.resource.data.seq == 1;
      allow update: if active() && request.resource.data.seq == resource.data.seq + 1;
      allow delete: if false;
    }
  }
}
